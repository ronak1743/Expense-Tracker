<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:orientation="vertical"
        android:background="#03A9F4">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:gravity="center_vertical"
            android:layout_height="wrap_content">
        <TextView
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_50sdp"
            android:text="@string/app_name"
            android:textSize="@dimen/_30sdp"
            android:fontFamily="@font/concert_one"
            android:textColor="@color/white"
            android:layout_marginLeft="@dimen/_10sdp">


        </TextView>
            <androidx.cardview.widget.CardView
                android:layout_marginLeft="@dimen/_40sdp"
                android:layout_width="@dimen/_40sdp"
                app:cardCornerRadius="@dimen/_20sdp"
                android:layout_height="@dimen/_40sdp">
            <ImageView

                android:id="@+id/user_logout"
                android:layout_width="@dimen/_40sdp"
                android:src="@drawable/usernamesingin"
                android:background="@color/white"
                android:layout_height="@dimen/_40sdp"
                tools:ignore="InvalidId">

            </ImageView>
            </androidx.cardview.widget.CardView>
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="1dp">
        </View>

        <LinearLayout
            android:paddingLeft="@dimen/_1sdp"
            android:paddingRight="@dimen/_1sdp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="@dimen/_200sdp"
                android:layout_height="wrap_content"
                android:text="Data"
                android:gravity="center"
                android:textSize="25dp"
                android:fontFamily="@font/concert_one"
                android:textColor="#FFC107"></TextView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Amount"
                android:gravity="center"
                android:textSize="25dp"
                android:fontFamily="@font/concert_one"
                android:textColor="#FFC107"></TextView>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycle_main"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_300sdp">

    </androidx.recyclerview.widget.RecyclerView>
<View
    android:layout_width="match_parent"
    android:background="@color/black"
    android:layout_height="1dp">

</View>

    <LinearLayout

        android:layout_width="match_parent"
        android:padding="@dimen/_10sdp"
        android:layout_height="@dimen/_80sdp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/blackborder"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="match_parent"
                android:textColor="#00D800"
                android:layout_weight="1"
                android:text="Cash In"
                android:gravity="center"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_height="wrap_content"></TextView>
        <TextView
            android:id="@+id/total_in_main"
            android:layout_width="match_parent"
            android:textSize="20dp"
            android:textColor="#00D800"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0"
            android:layout_height="wrap_content"></TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/blackborder"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="match_parent"
                android:textColor="#D5021D"
                android:layout_weight="1"
                android:textSize="20dp"
                android:text="Cash Out"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_height="wrap_content"></TextView>
            <TextView
                android:id="@+id/total_out_main"
                android:layout_width="match_parent"
                android:textSize="20dp"
                android:textColor="#D5021D"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:layout_height="wrap_content"></TextView>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:paddingLeft="@dimen/_10sdp"
        android:paddingRight="@dimen/_10sdp"
        android:layout_height="wrap_content">

            <Button
                android:id="@+id/cash_in_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="@dimen/_140sdp"
                android:layout_height="70dp"
                android:backgroundTint="#00D800"
                android:text="Cash in"
                android:textColorLink="@color/white"
                android:typeface="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.138"></Button>


            <Button
                android:layout_marginLeft="@dimen/_15sdp"
                android:id="@+id/cash_out_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="@dimen/_140sdp"
                android:layout_height="70dp"
                android:backgroundTint="#D5021D"
                android:text="Cash Out"
                android:textColorLink="@color/white"
                android:typeface="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.138"></Button>
    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp"

    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:background="@drawable/listmodelback"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/_2sdp"
            android:paddingRight="@dimen/_2sdp"
            android:paddingTop="5dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:text="Hellpnjfnvfvkjdbvkj"

                android:id="@+id/note_desing"
                android:gravity="left"
                android:textSize="20dp"
                android:layout_width="@dimen/_180sdp"
                android:textStyle="bold"

                android:layout_height="wrap_content"></TextView>
            <TextView
                android:paddingLeft="2dp"
                android:text="100000000"
                android:textSize="20dp"
                android:id="@+id/amount_desing"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content"></TextView>

        </LinearLayout>

        <LinearLayout
            android:paddingLeft="@dimen/_2sdp"
            android:layout_marginTop="10dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/date_desing"
                android:layout_width="@dimen/_80sdp"
                android:text="10-Dec-2024"
                android:gravity="center"
                android:textSize="18dp"
                android:layout_height="wrap_content"></TextView>
            <TextView
                android:layout_marginLeft="10dp"
                android:text="10:45 PM"
                android:id="@+id/time_desing"
                android:layout_width="wrap_content"
                android:textSize="18dp"
                android:layout_height="wrap_content"></TextView>
        </LinearLayout>


    </LinearLayout>


</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".UserToDB">

    <LinearLayout

        android:gravity="center"
        android:layout_width="match_parent"
        android:background="@drawable/backforsinget"
        android:layout_margin="@dimen/_20sdp"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_margin="8dp"
            android:padding="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:background="@drawable/backforsinget"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/amounttxt_user_to_db"
                android:layout_width="@dimen/_140sdp"
                android:text="Ammount"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:textSize="20dp"
                android:layout_height="wrap_content">
            </TextView>
            <EditText
                android:id="@+id/amount_usertodb"
                android:gravity="center"
                android:layout_width="match_parent"
                android:inputType="number"
                android:background="@color/white"
                android:textStyle="bold"
                android:hint="0"
                android:textSize="20dp"
                android:layout_height="wrap_content">
            </EditText>
        </LinearLayout>

        <LinearLayout

            android:padding="@dimen/_8sdp"
            android:layout_margin="8dp"
            android:layout_width="match_parent"
            android:background="@drawable/backforsinget"
            android:layout_height="wrap_content">
            <LinearLayout


                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:text="DATE"
                android:textSize="18dp"
                android:textStyle="bold"
                android:layout_height="wrap_content">

            </TextView>
            <EditText
                android:id="@+id/date_usertodb"
                android:layout_width="@dimen/_75sdp"
                android:background="@color/white"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:inputType="date"></EditText>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_marginLeft="@dimen/_8sdp"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="TIME"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content">

                </TextView>
                <EditText
                    android:id="@+id/time_usertodb"
                    android:layout_marginLeft="10dp"
                    android:layout_width="@dimen/_80sdp"
                    android:background="@color/white"
                    android:layout_height="wrap_content"
                    android:inputType="time"></EditText>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:padding="@dimen/_8sdp"
            android:layout_margin="8dp"
            android:background="@drawable/backforsinget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/note_usertodb"
                android:layout_width="match_parent"
                android:background="@color/white"
                android:textSize="20dp"
                android:hint="note"
                android:layout_height="wrap_content">
            </EditText>

        </LinearLayout>


        <Button
            android:id="@+id/submit_usertodb"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="170dp"
            android:layout_height="40dp"
            android:backgroundTint="#03A9F4"
            android:text="Submit"
            android:layout_margin="5dp"
            android:textColorLink="@color/white"
            android:typeface="normal"></Button>
    </LinearLayout>




</LinearLayout>
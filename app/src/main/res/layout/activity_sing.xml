<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="16dp"
    tools:context=".SingActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="250dp"
        android:gravity="bottom">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Back"
            android:fontFamily="@font/concert_one"
            android:textColor="@android:color/white"
            android:textSize="36sp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hey! Good to see you again"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal">

        <!-- Email Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/emailsingin"/>

            <EditText
                android:id="@+id/email_sing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:hint="Email"
                android:background="@android:color/transparent"
                android:inputType="textEmailAddress"
                android:textColor="#212121"
                android:textColorHint="#757575"/>
        </LinearLayout>

        <!-- Password Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/pass"/>

            <EditText
                android:id="@+id/password_sing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:hint="Password"
                android:background="@android:color/transparent"
                android:inputType="textPassword"
                android:textColor="#212121"
                android:textColorHint="#757575"/>
        </LinearLayout>

        <!-- Not have account -->
        <TextView
            android:id="@+id/nothaveAccount_sing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account?"
            android:textColor="#FF9800"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"/>

        <!-- SignIn Button -->
        <Button
            android:id="@+id/subit_sing"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Sign In"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:fontFamily="@font/concert_one"/>
    </LinearLayout>
</LinearLayout>
